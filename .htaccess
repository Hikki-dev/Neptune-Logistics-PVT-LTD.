# Neptune Logistics — Apache config for cPanel hosting
# Replaces vercel.json / middleware.js, which only work on Vercel.

# Disable MultiViews so mod_rewrite takes priority over file extension guessing
Options -MultiViews

# ---------- HTTPS + canonical host ----------
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

RewriteCond %{HTTP_HOST} ^www\.neptunelogistics\.lk$ [NC]
RewriteRule ^ https://neptunelogistics.lk%{REQUEST_URI} [L,R=301]

# ---------- Clean URLs (Strip .html and rewrite extensionless URLs) ----------
# 1. Externally redirect direct requests for /index.html to /
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+index\.html([?\s]) [NC]
RewriteRule ^ / [R=301,L]

RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*?/)index\.html([?\s]) [NC]
RewriteRule ^ /%1 [R=301,L]

# 2. Redirect legacy /career.html or /career to /careers
RewriteRule ^career(\.html)?$ /careers [R=301,L]

# 3. Redirect legacy service URLs if requested
RewriteRule ^services/sea-freight(\.html)?$ /ocean-cargo [R=301,L]
RewriteRule ^services/air-freight(\.html)?$ /air-cargo [R=301,L]
RewriteRule ^services/roadways(\.html)?$ /container-cargo [R=301,L]

# 4. Externally redirect any *.html file requests to extensionless clean URL (preserve query strings)
RewriteCond %{THE_REQUEST} ^[A-Z]{3,}\s/+(.*?)\.html([?\s]) [NC]
RewriteRule ^ /%1 [R=301,L]

# 5. Internally rewrite extensionless requests to *.html if the file exists
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*?)/?$ $1.html [L,QSA]

# ---------- Custom error page ----------
ErrorDocument 404 /404.html

# ---------- Content types for extensionless .well-known files ----------
<IfModule mod_mime.c>
  <FilesMatch "^(api-catalog|oauth-protected-resource|http-message-signatures-directory)$">
    ForceType application/json
  </FilesMatch>
  <FilesMatch "^(jwks\.json|openid-configuration|oauth-authorization-server)$">
    ForceType application/json
  </FilesMatch>
</IfModule>
AddType text/markdown .md
AddType application/json .json
AddType text/html .partial

# ---------- CORS + caching for the agent/AI discovery files ----------
<IfModule mod_headers.c>
  <FilesMatch "\.(md)$">
    Header set Access-Control-Allow-Origin "*"
  </FilesMatch>
  SetEnvIf Request_URI "^/\.well-known/" WELLKNOWN
  Header set Access-Control-Allow-Origin "*" env=WELLKNOWN
</IfModule>

# ---------- Compression ----------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml text/markdown
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
</IfModule>

# ---------- Browser caching for static assets ----------
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# ---------- Block direct access to sensitive files ----------
<FilesMatch "^(\.env|build\.js|package\.json|package-lock\.json|supabase_setup\.sql)$">
  Require all denied
</FilesMatch>

# ---------- Block access to .git (cPanel Git Version Control clones it into this folder) ----------
RewriteRule ^\.git/ - [F,L]
